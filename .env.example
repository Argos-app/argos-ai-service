# Exemplo da configuração integrada local via Docker Compose.
# Gere o .env real com scripts/docker/create-local-env.py; não copie segredos para este arquivo.
# Para execução individual, use apps/<serviço>/.env.example.

# Modo local
# Selecione simulated para rodar sem provedores externos.
ARGOS_MODEL_MODE=simulated
A2A_QDRANT_VECTOR_SIZE=64

# Modelos — API principal e A2A
# Preencha endpoints, nomes e chaves somente quando usar ARGOS_MODEL_MODE=provider.
MAIN_API_MODEL_API_BASE_URL=
MAIN_API_MODEL_API_KEY=
MAIN_API_MODEL_TIMEOUT_SECONDS=60
MAIN_API_MODEL_MAX_RETRIES=2
MAIN_API_MODEL_MAX_OUTPUT_TOKENS=4096
MAIN_API_MODEL_ROUTER=
MAIN_API_MODEL_FARM=
MAIN_API_MODEL_DOCTOR=
MAIN_API_MODEL_ANALYST=
MAIN_API_MODEL_SECRETARY=
MAIN_API_MODEL_INFORMATION=
MAIN_API_MODEL_ORCHESTRATOR=
MAIN_API_MODEL_JUDGE=
MAIN_API_MODEL_QUESTION_FORMATTER=
A2A_EMBEDDINGS_API_URL=
A2A_EMBEDDINGS_API_KEY=
A2A_EMBEDDINGS_MODEL=
A2A_EMBEDDINGS_MODEL_REVISION=
A2A_ANSWER_API_URL=
A2A_ANSWER_API_KEY=
A2A_ANSWER_MODEL=
A2A_MODEL_TIMEOUT_SECONDS=40
A2A_MODEL_MAX_OUTPUT_TOKENS=4096
MAIN_API_DOCUMENT_A2A_TIMEOUT_SECONDS=45

# E-mail — SMTP
# Deixe MCP_EMAIL_SMTP_HOST vazio para o Compose encaminhar ao Mailpit local.
MCP_EMAIL_SMTP_HOST=
MCP_EMAIL_SMTP_PORT=1025
MCP_EMAIL_SMTP_USERNAME=
MCP_EMAIL_SMTP_PASSWORD=
MCP_EMAIL_SMTP_USE_TLS=false
MCP_EMAIL_NO_REPLY_ADDRESS=no-reply@argos.local

# Tracing — LangSmith
# Opcional. Sem API key, não há envio; captura de conteúdo fica desativada por padrão.
# Use o workspace ID quando a chave for de escopo organizacional.
MAIN_API_LANGSMITH_API_KEY=
MAIN_API_LANGSMITH_PROJECT=argos-ai-service
MAIN_API_LANGSMITH_ENDPOINT=
MAIN_API_LANGSMITH_WORKSPACE_ID=
MAIN_API_LANGSMITH_CAPTURE_CONTENT=false
A2A_LANGSMITH_API_KEY=
A2A_LANGSMITH_PROJECT=argos-ai-service
A2A_LANGSMITH_ENDPOINT=
A2A_LANGSMITH_WORKSPACE_ID=
A2A_LANGSMITH_CAPTURE_CONTENT=false

# Bancos e collections — MongoDB
# O Compose integrado compartilha o banco e separa os dados por collections. URIs localhost são para execução no host.
MAIN_API_MONGO_URI=mongodb://localhost:27027/?replicaSet=rs0&directConnection=true
MCP_DATA_MONGO_URI=mongodb://localhost:27017/
MCP_EMAIL_MONGO_URI=mongodb://localhost:27017/
MAIN_API_MONGO_DATABASE=argos_ai
MCP_DATA_MONGO_DATABASE=argos_ai
MCP_EMAIL_MONGO_DATABASE=argos_ai
MAIN_API_OBSERVABILITY_COLLECTION=ai_observations
A2A_OBSERVABILITY_COLLECTION=ai_a2a_observations

# Telemetria — Redis
# Redis local para contadores efêmeros de uso e tokens.
REDIS_PUBLISHED_PORT=6379
OBSERVABILITY_REDIS_URL=redis://localhost:6379/0
USER_USAGE_REDIS_KEY_PREFIX=argos:usage:users:v1

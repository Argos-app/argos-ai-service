# Exemplo da configuração integrada local via Docker Compose.
# Gere o .env real com scripts/docker/create-local-env.py; não copie segredos para este arquivo.
# Para execução individual, use apps/<serviço>/.env.example.

# Modo local
# Selecione simulated para rodar sem provedores externos.
ARGOS_MODEL_MODE=simulated
APP_ENV=local
# stub fixa uma identidade apenas para desenvolvimento local. Em outros ambientes,
# autentique com Firebase e configure o JWT próprio do main_api.
AUTH_MODE=stub
# O modo simulated usa 64 em ambos; para provider use 1536 (OpenAI) e 1024 (Voyage 4 Large).
A2A_QDRANT_VECTOR_SIZE=64
A2A_QDRANT_VOYAGE_VECTOR_SIZE=64

# Publicação da API principal para testes locais.
# USB/adb reverse: mantenha 127.0.0.1. Wi-Fi em celular físico: use 0.0.0.0
# e informe ao app o IP LAN deste computador; restrinja a porta na firewall.
# MAIN_API_PUBLISHED_ADDRESS=127.0.0.1
# MAIN_API_PUBLISHED_PORT=8080

# Para autenticar com Firebase no Compose, defina o projeto e o caminho no host
# do JSON de service account. Use compose.firebase.yaml, que monta o arquivo em
# somente leitura dentro do container. Nunca versionar o JSON.
# MAIN_API_FIREBASE_PROJECT_ID=seu-firebase-project-id
# MAIN_API_FIREBASE_CREDENTIALS_HOST_PATH=C:/caminho/seguro/firebase-service-account.json

# Modelos OpenAI — modo provider
# Agentes rápidos compartilham o modelo rápido; especialistas usam o especialista.
OPENAI_API_KEY=
# Configure URLs compatíveis com a API do provider ou gateway escolhido; sem defaults.
OPENAI_BASE_URL=
OPENAI_EMBEDDINGS_URL=
VOYAGE_API_KEY=
VOYAGE_EMBEDDINGS_URL=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_SPECIALIST=gpt-6.1-terra
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL_FAST_FALLBACK=claude-haiku-5-5
ANTHROPIC_MODEL_SPECIALIST_FALLBACK=claude-sonnet-5-5
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
VOYAGE_EMBEDDINGS_MODEL=voyage-4-large
MAIN_API_MODEL_TIMEOUT_SECONDS=60
MAIN_API_MODEL_MAX_RETRIES=2
MAIN_API_EXECUTION_TIMEOUT_SECONDS=300
MAIN_API_MODEL_MAX_OUTPUT_TOKENS=4096
# Valores padrão de API direta consultados em 2026-10; ajuste para preços do gateway escolhido.
# Tarifas estimadas em USD por 1 milhão de tokens, separadas por modelo/papel.
MODEL_FAST_INPUT_COST_PER_MILLION_TOKENS=0.10
MODEL_FAST_OUTPUT_COST_PER_MILLION_TOKENS=0.50
MODEL_FAST_FALLBACK_INPUT_COST_PER_MILLION_TOKENS=0.10
MODEL_FAST_FALLBACK_OUTPUT_COST_PER_MILLION_TOKENS=0.50
MODEL_SPECIALIST_INPUT_COST_PER_MILLION_TOKENS=1.00
MODEL_SPECIALIST_OUTPUT_COST_PER_MILLION_TOKENS=5.00
MODEL_SPECIALIST_FALLBACK_INPUT_COST_PER_MILLION_TOKENS=2.00
MODEL_SPECIALIST_FALLBACK_OUTPUT_COST_PER_MILLION_TOKENS=10.00
MODEL_EMBEDDING_INPUT_COST_PER_MILLION_TOKENS=0.02
MODEL_EMBEDDING_FALLBACK_INPUT_COST_PER_MILLION_TOKENS=0.12
A2A_MODEL_TIMEOUT_SECONDS=40
A2A_MODEL_MAX_OUTPUT_TOKENS=4096
MAIN_API_DOCUMENT_A2A_TIMEOUT_SECONDS=45

# E-mail — SMTP
# Deixe MCP_EMAIL_SMTP_HOST vazio para o Compose encaminhar ao Mailpit local.
MCP_EMAIL_SMTP_HOST=
MCP_EMAIL_SMTP_PORT=1025
MCP_EMAIL_SMTP_USERNAME=
MCP_EMAIL_SMTP_PASSWORD=
MCP_EMAIL_SMTP_USE_TLS=false
MCP_EMAIL_NO_REPLY_ADDRESS=no-reply@argos.local

# Tracing — LangSmith
# Opcional. Sem API key, não há envio; captura de conteúdo fica desativada por padrão.
# Use o workspace ID quando a chave for de escopo organizacional.
MAIN_API_LANGSMITH_API_KEY=
MAIN_API_LANGSMITH_AGENT_ID=argos-ai-service
# Opcional: vazio usa APP_ENV (local/development/staging/production).
MAIN_API_LANGSMITH_AGENT_ENVIRONMENT=
MAIN_API_LANGSMITH_ENDPOINT=
MAIN_API_LANGSMITH_WORKSPACE_ID=
MAIN_API_LANGSMITH_CAPTURE_CONTENT=false
A2A_LANGSMITH_API_KEY=
A2A_LANGSMITH_AGENT_ID=argos-ai-service
# Opcional: vazio usa APP_ENV (local/development/staging/production).
A2A_LANGSMITH_AGENT_ENVIRONMENT=
A2A_LANGSMITH_ENDPOINT=
A2A_LANGSMITH_WORKSPACE_ID=
A2A_LANGSMITH_CAPTURE_CONTENT=false

# Bancos e collections — MongoDB
# O Compose integrado compartilha o banco e separa os dados por collections. URIs localhost são para execução no host.
MAIN_API_MONGO_URI=mongodb://localhost:27027/?replicaSet=rs0&directConnection=true
MCP_DATA_MONGO_URI=mongodb://localhost:27017/
MCP_EMAIL_MONGO_URI=mongodb://localhost:27017/
# Os nomes das collections são definidos no código; consulte docs/mongodb-configuration.md.
MAIN_API_MONGO_DATABASE=argos_ai
MCP_DATA_MONGO_DATABASE=argos_ai
MCP_EMAIL_MONGO_DATABASE=argos_ai

# Telemetria — Redis
# Redis local para contadores efêmeros de uso e tokens.
REDIS_PUBLISHED_PORT=6379
OBSERVABILITY_REDIS_URL=redis://localhost:6379/0
USER_USAGE_REDIS_KEY_PREFIX=argos:usage:users:v1

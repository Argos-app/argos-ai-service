# Configuração Mongo compartilhada: cada serviço usa uma collection própria no
# banco argos_ai. Arquivos .env não são carregados automaticamente pelo Python;
# exporte as variáveis no processo ou use --env-file no Compose.
# URI para execução no host (ajuste as portas ao Mongo local disponível):
MAIN_API_MONGO_URI=mongodb://localhost:27027/?replicaSet=rs0&directConnection=true
MCP_DATA_MONGO_URI=mongodb://localhost:27017/
MCP_EMAIL_MONGO_URI=mongodb://localhost:27017/
MAIN_API_MONGO_DATABASE=argos_ai
MAIN_API_OBSERVABILITY_COLLECTION=ai_observations
A2A_OBSERVABILITY_COLLECTION=ai_a2a_observations
REDIS_PUBLISHED_PORT=6379
OBSERVABILITY_REDIS_URL=redis://localhost:6379/0
USER_USAGE_REDIS_KEY_PREFIX=argos:usage:users:v1
MCP_DATA_MONGO_DATABASE=argos_ai
MCP_EMAIL_MONGO_DATABASE=argos_ai

# No Compose integrado, substitua os URIs por DNS/portas internos dos serviços,
# por exemplo mongodb://mongo:27017/?replicaSet=rs0 para o main_api.
# O Compose integrado usa estes nomes para observabilidade local best-effort.
# Para execução individual, configure também a URI/coleção A2A em
# apps/a2a_agent/.env.example. A matriz completa está em docs/configuracao-mongodb.md.
# Não coloque credenciais reais neste arquivo.

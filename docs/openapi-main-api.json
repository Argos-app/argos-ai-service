    "/v1/auth/firebase": {
      "post": {
        "tags": ["auth"],
        "summary": "Authenticate Firebase",
        "description": "Troca Firebase ID token válido por JWT mínimo do serviço de IA.",
        "operationId": "authenticate_firebase_v1_auth_firebase_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"

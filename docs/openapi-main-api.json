                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "403": {
            "description": "A sessão não pertence ao escopo autorizado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "404": {
            "description": "Sessão ou interação não encontrada.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "422": {
            "description": "Identificador inválido.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "503": {
            "description": "Serviço de sessão indisponível.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/firebase": {
      "post": {
        "tags": ["auth"],
        "summary": "Autenticar com Firebase",
        "description": "Valida um Firebase ID token enviado no cabeçalho Authorization e emite um token de acesso do serviço. O token Firebase não deve ser enviado no corpo.",
        "operationId": "authenticate_firebase_v1_auth_firebase_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Firebase ID token no formato Bearer <token>.",
              "examples": ["Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."],
              "title": "Authorization"
            },
            "description": "Firebase ID token no formato Bearer <token>."
          }
        ],
        "responses": {
          "200": {
            "description": "Token de acesso do serviço emitido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, expirado ou revogado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "403": {
            "description": "Usuário sem cadastro habilitado ou sem propriedades autorizadas.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "503": {
            "description": "Autenticação Firebase ou consulta cadastral indisponível.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1,
            "title": "Access Token",
            "description": "Token Bearer emitido pelo serviço para as próximas requisições.",
            "examples": ["eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9..."]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["access_token"],
        "title": "AccessTokenResponse",
        "description": "Token emitido para autenticar chamadas à API do Argos."
      },
      "AnswerChoice": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "choice",
            "title": "Kind",
            "description": "Discriminador da resposta; use `choice`."
          },
          "option_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Option Id",
            "description": "option_id de uma das opções da pergunta pendente.",
            "examples": ["option-1"]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "option_id"],
        "title": "AnswerChoice",
        "description": "Seleção de uma opção de resposta oferecida pelo serviço."
      },
      "AnswerConfirmation": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "confirmation",
            "title": "Kind",
            "description": "Discriminador da resposta; use `confirmation`."
          },
          "confirm": {
            "type": "boolean",
            "title": "Confirm",
            "description": "Use true para confirmar ou false para recusar.",
            "examples": [true]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "confirm"],
        "title": "AnswerConfirmation",
        "description": "Confirmação ou recusa de uma ação solicitada."
      },
      "AnswerInteraction": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "answer",
            "title": "Kind",
            "description": "Discriminador da interação; use `answer`."
          },
          "interaction_id": {
            "type": "string",
            "format": "uuid",
            "title": "Interaction Id",
            "description": "Identificador da interação que apresentou a pergunta.",
            "examples": ["123e4567-e89b-12d3-a456-426614174002"]
          },
          "question_id": {
            "type": "string",
            "format": "uuid",
            "title": "Question Id",
            "description": "Identificador da pergunta que está sendo respondida.",
            "examples": ["123e4567-e89b-12d3-a456-426614174003"]
          },
          "answer": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AnswerText"
              },
              {
                "$ref": "#/components/schemas/AnswerChoice"
              },
              {
                "$ref": "#/components/schemas/AnswerConfirmation"
              }
            ],
            "title": "Answer",
            "description": "Resposta em texto, seleção ou confirmação.",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "choice": "#/components/schemas/AnswerChoice",
                "confirmation": "#/components/schemas/AnswerConfirmation",
                "text": "#/components/schemas/AnswerText"
              }
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["kind", "interaction_id", "question_id", "answer"],
        "title": "AnswerInteraction",

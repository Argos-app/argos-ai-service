{
  "openapi": "3.1.0",
  "info": {
    "title": "Argos AI Service",
    "description": "Gerencia sessões autenticadas e interações com os agentes do Argos. Cada resposta inclui o cabeçalho X-Argos-Correlation-ID para diagnóstico.",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": ["health"],
        "summary": "Verificar se o processo está ativo",
        "description": "Retorna uma resposta simples quando o processo HTTP está em execução.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "O processo está ativo.",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["health"],
        "summary": "Verificar se o serviço está pronto",
        "description": "Verifica dependências essenciais, incluindo persistência, autenticação, runtime dos agentes e integração documental quando configurada.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "O serviço está pronto para receber requisições.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Uma ou mais dependências essenciais estão indisponíveis."
          }
        }
      }
    },
    "/v1/sessions": {
      "get": {
        "tags": ["sessions"],
        "summary": "Listar sessões",
        "description": "Lista as sessões pertencentes ao usuário autenticado.",
        "operationId": "list_sessions_v1_sessions_get",
        "responses": {
          "200": {
            "description": "Sessões do usuário autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  },
                  "type": "array",
                  "title": "Response List Sessions V1 Sessions Get"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "403": {
            "description": "Usuário sem acesso habilitado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "503": {
            "description": "Persistência ou serviço de identidade indisponível.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["sessions"],
        "summary": "Criar sessão",
        "description": "Cria uma sessão para o usuário autenticado e retorna seu identificador.",
        "operationId": "create_session_v1_sessions_post",
        "responses": {
          "201": {
            "description": "Sessão criada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "403": {
            "description": "Usuário sem acesso habilitado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "503": {
            "description": "Persistência ou serviço de identidade indisponível.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/messages": {
      "get": {
        "tags": ["sessions"],
        "summary": "Consultar mensagens da sessão",
        "description": "Retorna mensagens sanitizadas em ordem cronológica. Use next_cursor para buscar a próxima página.",
        "operationId": "list_session_messages_v1_sessions__session_id__messages_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Identificador UUID da sessão consultada.",
              "examples": ["123e4567-e89b-12d3-a456-426614174000"],
              "title": "Session Id"
            },
            "description": "Identificador UUID da sessão consultada."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Quantidade máxima de mensagens retornadas nesta página.",
              "examples": [50],
              "default": 50,
              "title": "Limit"
            },
            "description": "Quantidade máxima de mensagens retornadas nesta página."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cursor opaco retornado como next_cursor na página anterior.",
              "examples": ["cursor-opaco-retornado-pela-api"],
              "title": "Cursor"
            },
            "description": "Cursor opaco retornado como next_cursor na página anterior."
          }
        ],
        "responses": {
          "200": {
            "description": "Página de mensagens da sessão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionMessagesPage"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "403": {
            "description": "A sessão não pertence ao escopo autorizado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "404": {
            "description": "Sessão não encontrada.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "422": {
            "description": "Identificador ou parâmetro inválido.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "503": {
            "description": "Histórico da sessão indisponível.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/interactions/async": {
      "post": {
        "tags": ["interactions"],
        "summary": "Enviar interação para processamento",
        "description": "Aceita uma nova mensagem ou uma resposta a uma pergunta pendente. O processamento ocorre em segundo plano; consulte operation_id para acompanhar o estado.",
        "operationId": "create_interaction_async_v1_sessions__session_id__interactions_async_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Identificador UUID da sessão que receberá a interação.",
              "examples": ["123e4567-e89b-12d3-a456-426614174000"],
              "title": "Session Id"
            },
            "description": "Identificador UUID da sessão que receberá a interação."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/MessageInteraction"
                  },
                  {
                    "$ref": "#/components/schemas/AnswerInteraction"
                  }
                ],
                "title": "Body"
              },
              "examples": {
                "mensagem": {
                  "summary": "Enviar uma mensagem",
                  "description": "Inicia uma interação com uma mensagem do usuário.",
                  "value": {
                    "kind": "message",
                    "client_message_id": "123e4567-e89b-12d3-a456-426614174001",
                    "message": "Quantos animais há no lote 12?"
                  }
                },
                "resposta": {
                  "summary": "Responder a uma pergunta pendente",
                  "description": "Envia uma resposta vinculada à pergunta e à interação originais.",
                  "value": {
                    "kind": "answer",
                    "interaction_id": "123e4567-e89b-12d3-a456-426614174002",
                    "question_id": "123e4567-e89b-12d3-a456-426614174003",
                    "answer": {
                      "kind": "text",
                      "text": "Lote 12"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Interação aceita para processamento em segundo plano.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionAccepted"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "description": "Conteúdo da interação inválido.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "403": {
            "description": "A sessão não pertence ao escopo autorizado.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "404": {
            "description": "Sessão ou pergunta não encontrada.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "409": {
            "description": "Interação incompatível com o estado atual da sessão.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "422": {
            "description": "Corpo ou parâmetro inválido.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "503": {
            "description": "Serviço de sessão indisponível.",
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/interactions/{operation_id}": {
      "get": {
        "tags": ["interactions"],
        "summary": "Consultar estado da interação",

              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionOperationStatus"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {

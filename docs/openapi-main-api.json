  "paths": {
    "/health/live": {
      "get": {
        "tags": ["health"],
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["health"],
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Persistência Mongo indisponível"
          }
        }
      }
    },
    "/v1/sessions": {
      "get": {
        "tags": ["sessions"],
        "summary": "List Sessions",
        "operationId": "list_sessions_v1_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  },
                  "type": "array",
                  "title": "Response List Sessions V1 Sessions Get"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["sessions"],
        "summary": "Create Session",
        "operationId": "create_session_v1_sessions_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/messages": {
      "get": {
        "tags": ["sessions"],
        "summary": "List Session Messages",
        "operationId": "list_session_messages_v1_sessions__session_id__messages_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionMessagesPage"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/interactions/async": {
      "post": {
        "tags": ["interactions"],
        "summary": "Create Interaction Async",
        "description": "Aceita a interação e deixa o processamento seguir em segundo plano.",
        "operationId": "create_interaction_async_v1_sessions__session_id__interactions_async_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/MessageInteraction"
                  },
                  {
                    "$ref": "#/components/schemas/AnswerInteraction"
                  }
                ],
                "discriminator": {
                  "propertyName": "kind",
                  "mapping": {
                    "message": "#/components/schemas/MessageInteraction",
                    "answer": "#/components/schemas/AnswerInteraction"
                  }
                },
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InteractionAccepted"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "headers": {
              "X-Argos-Correlation-ID": {
                "description": "Identificador de correlação desta requisição no serviço Argos.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/interactions/{operation_id}": {
      "get": {
        "tags": ["interactions"],
        "summary": "Get Interaction Operation",
        "operationId": "get_interaction_operation_v1_sessions__session_id__interactions__operation_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",

# Endpoint de descoberta usado pelo Agent Card; pode ser DNS interno.
A2A_ENDPOINT_URL=https://a2a.internal.example/a2a
A2A_HOST=0.0.0.0
A2A_PORT=8000
A2A_PUBLISHED_PORT=8000

# Endpoints HTTPS OpenAI-compatible: embeddings e chat completions.
A2A_EMBEDDINGS_API_URL=https://faiis.internal.example/v1/embeddings
A2A_EMBEDDINGS_API_KEY=replace-with-faiis-api-key
A2A_EMBEDDINGS_MODEL=replace-with-embedding-model
A2A_EMBEDDINGS_MODEL_REVISION=replace-with-immutable-model-revision
A2A_ANSWER_API_URL=https://llm.internal.example/v1/chat/completions
A2A_ANSWER_API_KEY=replace-with-llm-api-key
A2A_ANSWER_MODEL=replace-with-answer-model
A2A_MODEL_TIMEOUT_SECONDS=40
A2A_MODEL_MAX_OUTPUT_TOKENS=4096
A2A_MODEL_MODE=provider

# Usuário PostgreSQL read-only. Todos os níveis ativos recebem o mesmo acesso
# documental quando a chamada apresenta delegação válida para documents.read.
A2A_PERMISSION_SQL_DSN=postgresql://a2a_reader:replace-with-password@postgres.internal/argos
A2A_DOCUMENTS_PATH=./data/documents

# Qdrant: credenciais diferentes; a credencial de escrita só é usada pelo sincronizador.
A2A_QDRANT_URL=https://qdrant.internal.example
A2A_QDRANT_READ_API_KEY=replace-with-read-only-key
A2A_QDRANT_WRITE_API_KEY=replace-with-index-writer-key
A2A_QDRANT_COLLECTION=argos_global_documents
# Dimensão do modelo configurado em A2A_EMBEDDINGS_API_URL.
A2A_QDRANT_VECTOR_SIZE=replace-with-model-dimension
A2A_QDRANT_DISTANCE=Cosine
A2A_QDRANT_TIMEOUT_SECONDS=5

# Corpus PDF local de demonstração (sintético; não usar como fonte jurídica).
# A montagem é read-only; substitua o caminho por um corpus aprovado no deployment.
A2A_DOCUMENT_SOURCE_ROOT=/var/lib/argos/a2a/documents
A2A_DOCUMENT_CATALOG_NAME=catalog.json
A2A_MANIFEST_PATH=/var/lib/argos/a2a/state/manifest.json

# Persistência opcional das métricas brutas; sem URI/coleção, a coleta fica desabilitada.
# A URI é segredo. Configure o nome da coleção aprovado para este deployment.
# A2A_OBSERVABILITY_MONGO_URI=mongodb://user:password@mongo.internal/?replicaSet=rs0
# A2A_OBSERVABILITY_MONGO_DATABASE=argos_ai
# A2A_OBSERVABILITY_COLLECTION=ai_a2a_observations
# A2A_OBSERVABILITY_QUEUE_MAX_ITEMS=2048
# A2A_OBSERVABILITY_QUEUE_MAX_BYTES=8388608
# A2A_OBSERVABILITY_DOCUMENT_MAX_BYTES=16384
# A2A_OBSERVABILITY_BATCH_SIZE=100
# A2A_OBSERVABILITY_BATCH_INTERVAL_MS=250
# A2A_OBSERVABILITY_MAX_ATTEMPTS=3
# A2A_OBSERVABILITY_RETRY_BASE_DELAY_MS=50
# A2A_OBSERVABILITY_SHUTDOWN_TIMEOUT_MS=2000

# Projeção efêmera para ranking de consumo nas últimas 24h (opcional localmente).
# A2A_OBSERVABILITY_REDIS_URL=redis://localhost:6379/0
# USER_USAGE_REDIS_KEY_PREFIX=argos:usage:users:v1

# LangSmith opcional para traces dos agentes A2A e geração de respostas.
# A chave é um secret; entradas e saídas ficam ocultas por padrão.
# A2A_LANGSMITH_API_KEY=
# A2A_LANGSMITH_PROJECT=argos-ai-service
# A2A_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# A2A_LANGSMITH_WORKSPACE_ID=workspace-id-for-organization-scoped-key
# A2A_LANGSMITH_CAPTURE_CONTENT=false

# Bearer de serviço e chave pública do emissor Ed25519 da delegação.
A2A_INTERNAL_SERVICE_TOKEN=replace-with-service-token
A2A_RESOURCE_SERVER_URL=https://a2a.internal.example/a2a
A2A_DELEGATION_ISSUER=https://identity.internal.example
A2A_TRUSTED_DELEGATION_KEYS={"key-2026":"replace-with-base64-ed25519-public-key"}
A2A_DELEGATION_MAX_TTL=300
A2A_DELEGATION_CLOCK_SKEW=30

# A dimensão do modelo de embeddings precisa corresponder à coleção Qdrant.

# Template para execução individual do MCP de e-mail no host.
# O código lê variáveis do processo; carregar este arquivo é responsabilidade do shell.
MCP_EMAIL_SERVICE_NAME=mcp_email
MCP_EMAIL_MONGO_URI=mongodb://localhost:27017/
MCP_EMAIL_MONGO_DATABASE=argos_ai
MCP_EMAIL_REPORTS_COLLECTION=ai_email_prepared_reports
MCP_EMAIL_DISPATCH_COLLECTION=ai_email_dispatches

# O DSN e as chaves abaixo devem ser fornecidos pelo ambiente e nunca versionados.
MCP_EMAIL_SQL_DSN=postgresql://READ_ONLY_USER:URL_ENCODED_PASSWORD@localhost:5432/DATABASE
MCP_EMAIL_TRUSTED_SIGNATURE_KEYS={"BACKEND_KEY_ID":"BASE64_RAW_ED25519_PUBLIC_KEY"}
MCP_EMAIL_INTERNAL_SERVICE_TOKEN=REPLACE_WITH_SECRET
MCP_EMAIL_AUTH_ISSUER_URL=http://127.0.0.1:8000
MCP_EMAIL_RESOURCE_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_EMAIL_HOST=127.0.0.1
MCP_EMAIL_PORT=8000
MCP_EMAIL_NO_REPLY_ADDRESS=no-reply@argos.local

# Necessário somente para envio; preparação e consulta de status não conectam SMTP.
MCP_EMAIL_SMTP_HOST=
MCP_EMAIL_SMTP_PORT=587
MCP_EMAIL_SMTP_USERNAME=
MCP_EMAIL_SMTP_PASSWORD=
MCP_EMAIL_SMTP_USE_TLS=true

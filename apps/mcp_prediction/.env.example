# Runtime do MCP de predicao; use credencial SQL restrita a leitura.
# O runtime nao aplica grants ou migracoes.
MCP_PREDICTION_SQL_DSN=
MCP_PREDICTION_SQL_TIMEOUT_SECONDS=5
MCP_PREDICTION_INTERNAL_SERVICE_TOKEN=
MCP_PREDICTION_AUTH_ISSUER_URL=http://127.0.0.1:8000
MCP_PREDICTION_RESOURCE_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_PREDICTION_HOST=127.0.0.1
MCP_PREDICTION_PORT=8000
MCP_PREDICTION_DATA_ORIGIN=unknown

# Emissor confiavel e chaves PUBLICAS Ed25519 Base64; nunca incluir chave privada.
MCP_PREDICTION_DELEGATION_ISSUER=
MCP_PREDICTION_TRUSTED_DELEGATION_KEYS={}
MCP_PREDICTION_DELEGATION_MAX_TTL=300
MCP_PREDICTION_DELEGATION_CLOCK_SKEW=30

# Mongo replica set usado pela persistência durável do main_api.
# Para execução no host contra o replica set do compose de testes. Em Compose
# integrado, use a rede interna (por exemplo mongodb://mongo:27017/?replicaSet=rs0).
MAIN_API_MONGO_URI=mongodb://localhost:27027/?replicaSet=rs0&directConnection=true
MAIN_API_MONGO_DATABASE=argos_ai
MAIN_API_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MAIN_API_MONGO_WRITE_TIMEOUT_MS=5000

# Banco cadastral PostgreSQL. Use uma credencial dedicada com SELECT somente
# em app_user, permission, property e user_property. A conexão configurada pelo
# serviço também força todas as transações para READ ONLY.
# MAIN_API_AUTH_DATABASE_URL=postgresql://argos_reader:...@localhost:54327/argos
# MAIN_API_AUTH_DATABASE_POOL_MIN_SIZE=1
# MAIN_API_AUTH_DATABASE_POOL_MAX_SIZE=5
# MAIN_API_AUTH_DATABASE_CONNECT_TIMEOUT_SECONDS=3
# MAIN_API_AUTH_DATABASE_QUERY_TIMEOUT_SECONDS=3

# Firebase Admin para verificar Firebase ID tokens (incluindo revogação).
# Use credenciais ADC no ambiente, ou informe um caminho para uma chave de
# service account montada como secret; não armazene o JSON da chave no repositório.
# MAIN_API_FIREBASE_PROJECT_ID=seu-firebase-project-id
# MAIN_API_FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json

# JWT próprio do main_api. Use um par Ed25519 PKCS#8 DER exclusivo para acesso,
# diferente do par MAIN_API_MCP_DELEGATION_*. Armazene a chave privada Base64
# em um secret. O token leva o UUID interno no sub e o UID Firebase; cadastro,
# permissões e fazendas são recarregados do PostgreSQL em cada chamada.
# MAIN_API_ACCESS_TOKEN_ISSUER=argos-ai-service
# MAIN_API_ACCESS_TOKEN_AUDIENCE=argos-ai-service-api
# MAIN_API_ACCESS_TOKEN_KEY_ID=main-api-access-v1
# MAIN_API_ACCESS_TOKEN_PRIVATE_KEY=BASE64_PKCS8_DER_ED25519_PRIVATE_KEY
# MAIN_API_ACCESS_TOKEN_TTL_SECONDS=300

# Observabilidade usa ai_observations quando MAIN_API_MONGO_URI está configurada.
# MAIN_API_OBSERVABILITY_QUEUE_MAX_ITEMS=2048
# MAIN_API_OBSERVABILITY_QUEUE_MAX_BYTES=8388608
# MAIN_API_OBSERVABILITY_DOCUMENT_MAX_BYTES=16384
# MAIN_API_OBSERVABILITY_BATCH_SIZE=100
# MAIN_API_OBSERVABILITY_BATCH_INTERVAL_MS=250
# MAIN_API_OBSERVABILITY_MAX_ATTEMPTS=3
# MAIN_API_OBSERVABILITY_RETRY_BASE_DELAY_MS=50
# MAIN_API_OBSERVABILITY_SHUTDOWN_TIMEOUT_MS=2000

MAIN_API_SESSION_SUMMARY_INPUT_MAX_TOKENS=8000

# Os agentes rápidos compartilham OPENAI_MODEL_FAST; especialistas usam
# OPENAI_MODEL_SPECIALIST. Sumarização e extração de memória usam o modelo rápido.
# Sem configuração completa, /health/ready informa indisponibilidade do runtime.
OPENAI_API_KEY=
# URLs do provider/gateway que implementa os protocolos usados pelos adapters.
OPENAI_BASE_URL=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_SPECIALIST=gpt-6.1-terra
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL_FAST_FALLBACK=claude-haiku-5-5
ANTHROPIC_MODEL_SPECIALIST_FALLBACK=claude-sonnet-5-5
MAIN_API_MODEL_MODE=provider
MAIN_API_MODEL_TIMEOUT_SECONDS=60
MAIN_API_MODEL_MAX_RETRIES=2
MAIN_API_MODEL_MAX_OUTPUT_TOKENS=4096
MAIN_API_EXECUTION_MAX_MODEL_CALLS=12
MAIN_API_EXECUTION_MAX_TOOL_CALLS=12
MAIN_API_EXECUTION_TIMEOUT_SECONDS=300

# Valores padrão de API direta consultados em 2026-10; ajuste para preços do gateway escolhido.
# Tarifas estimadas em USD por 1 milhão de tokens quando não houver custo explícito.
MODEL_FAST_INPUT_COST_PER_MILLION_TOKENS=0.10
MODEL_FAST_OUTPUT_COST_PER_MILLION_TOKENS=0.50
MODEL_FAST_FALLBACK_INPUT_COST_PER_MILLION_TOKENS=0.10
MODEL_FAST_FALLBACK_OUTPUT_COST_PER_MILLION_TOKENS=0.50
MODEL_SPECIALIST_INPUT_COST_PER_MILLION_TOKENS=1.00
MODEL_SPECIALIST_OUTPUT_COST_PER_MILLION_TOKENS=5.00
MODEL_SPECIALIST_FALLBACK_INPUT_COST_PER_MILLION_TOKENS=2.00
MODEL_SPECIALIST_FALLBACK_OUTPUT_COST_PER_MILLION_TOKENS=10.00

# LangSmith é opcional. Sem API key, nenhum trace é enviado.
# A chave é um secret. Prompts e respostas ficam ocultos até habilitar explicitamente.
# MAIN_API_LANGSMITH_API_KEY=
# Use o mesmo Agent ID em todos os ambientes para agrupá-los sob o mesmo Agent.
# MAIN_API_LANGSMITH_AGENT_ID=argos-ai-service
# Vazio usa APP_ENV; valores aceitos: local, development, staging, production.
# MAIN_API_LANGSMITH_AGENT_ENVIRONMENT=
# MAIN_API_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# MAIN_API_LANGSMITH_WORKSPACE_ID=workspace-id-for-organization-scoped-key
# MAIN_API_LANGSMITH_CAPTURE_CONTENT=false

# As rotas protegidas aceitam somente o JWT próprio emitido após validação Firebase.
# AUTH_MODE=stub só é permitido em APP_ENV=local.
APP_ENV=local
AUTH_MODE=stub

# Endpoints Streamable HTTP dos MCPs. Cada URL aponta para o endpoint /mcp.
MAIN_API_MCP_DATA_URL=https://MCP_DATA_HOST/mcp
MAIN_API_MCP_DATA_TOKEN=
# Chaves públicas Ed25519 em Base64 confiadas para envelopes LotReportEnvelope.
MAIN_API_MCP_DATA_REPORT_TRUSTED_SIGNATURE_KEYS={"REPORT_SIGNING_KEY_ID":"BASE64_RAW_ED25519_PUBLIC_KEY"}
MAIN_API_MCP_PREDICTION_URL=https://MCP_PREDICTION_HOST/mcp
MAIN_API_MCP_PREDICTION_TOKEN=
MAIN_API_MCP_EMAIL_URL=https://MCP_EMAIL_HOST/mcp
MAIN_API_MCP_EMAIL_TOKEN=
MAIN_API_MCP_TIMEOUT_SECONDS=10
MAIN_API_MCP_RESPONSE_MAX_BYTES=1000000

# Chave PKCS#8 DER Ed25519, codificada em Base64, para assinar delegações por chamada.
# Configure a chave pública correspondente e o mesmo issuer nos MCPs Data e Prediction.
MAIN_API_MCP_DELEGATION_ISSUER=argos-main-service
MAIN_API_MCP_DELEGATION_KEY_ID=MAIN_API_DELEGATION_KEY_ID
MAIN_API_MCP_DELEGATION_PRIVATE_KEY=BASE64_PKCS8_DER_ED25519_PRIVATE_KEY
MAIN_API_MCP_DELEGATION_TTL_SECONDS=240

# Cliente opcional do serviço documental A2A. O issuer deve coincidir com
# A2A_DELEGATION_ISSUER no serviço A2A; a URL é também a audience assinada.
# MAIN_API_DOCUMENT_A2A_URL=https://a2a.internal.example/a2a
# MAIN_API_DOCUMENT_A2A_SERVICE_TOKEN=replace-with-a2a-service-token
# MAIN_API_DOCUMENT_A2A_TIMEOUT_SECONDS=45
# MAIN_API_DOCUMENT_A2A_RESPONSE_MAX_BYTES=1000000
# Contadores efêmeros de chamadas e tokens por usuário (opcional localmente).
MAIN_API_OBSERVABILITY_REDIS_URL=redis://localhost:6379/0
USER_USAGE_REDIS_KEY_PREFIX=argos:usage:users:v1
MAIN_API_AUTH_DATABASE_URL=
MAIN_API_FIREBASE_PROJECT_ID=
MAIN_API_FIREBASE_CREDENTIALS_FILE=
MAIN_API_ACCESS_TOKEN_KEY_ID=
MAIN_API_ACCESS_TOKEN_PRIVATE_KEY=
MAIN_API_DOCUMENT_A2A_URL=
MAIN_API_DOCUMENT_A2A_SERVICE_TOKEN=
MAIN_API_LANGSMITH_API_KEY=
MAIN_API_LANGSMITH_ENDPOINT=
MAIN_API_LANGSMITH_WORKSPACE_ID=
MAIN_API_LANGSMITH_CAPTURE_CONTENT=false

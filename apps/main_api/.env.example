# Mongo replica set usado pela persistência durável do main_api.
MAIN_API_MONGO_URI=mongodb://localhost:27027/?replicaSet=rs0
MAIN_API_MONGO_DATABASE=argos_ai
MAIN_API_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MAIN_API_MONGO_WRITE_TIMEOUT_MS=5000
MAIN_API_SESSION_SUMMARY_INPUT_MAX_TOKENS=8000

# Chaves públicas Ed25519 em Base64 raw (32 bytes), indexadas pelo kid do backend.
# Nunca configure a chave privada aqui.
MAIN_API_AUTH_ISSUER=argos-backend-service
MAIN_API_AUTH_AUDIENCE=argos-ai-service
MAIN_API_AUTH_TRUSTED_PUBLIC_KEYS={"BACKEND_KEY_ID":"BASE64_RAW_ED25519_PUBLIC_KEY"}
MAIN_API_AUTH_TOKEN_MAX_TTL_SECONDS=300
MAIN_API_AUTH_CLOCK_SKEW_SECONDS=30

# Endpoints Streamable HTTP dos MCPs. Cada URL aponta para o endpoint /mcp.
MAIN_API_MCP_DATA_URL=https://MCP_DATA_HOST/mcp
MAIN_API_MCP_DATA_TOKEN=
MAIN_API_MCP_PREDICTION_URL=https://MCP_PREDICTION_HOST/mcp
MAIN_API_MCP_PREDICTION_TOKEN=
MAIN_API_MCP_EMAIL_URL=https://MCP_EMAIL_HOST/mcp
MAIN_API_MCP_EMAIL_TOKEN=
MAIN_API_MCP_TIMEOUT_SECONDS=10
MAIN_API_MCP_RESPONSE_MAX_BYTES=1000000

# Chave PKCS#8 DER Ed25519, codificada em Base64, para assinar delegações por chamada.
# Configure a chave pública correspondente e o mesmo issuer nos MCPs Data e Prediction.
MAIN_API_MCP_DELEGATION_ISSUER=argos-main-service
MAIN_API_MCP_DELEGATION_KEY_ID=MAIN_API_DELEGATION_KEY_ID
MAIN_API_MCP_DELEGATION_PRIVATE_KEY=BASE64_PKCS8_DER_ED25519_PRIVATE_KEY
MAIN_API_MCP_DELEGATION_TTL_SECONDS=240

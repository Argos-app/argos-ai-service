# Mongo replica set usado pela persistência durável do main_api.
# Para execução no host contra o replica set do compose de testes. Em Compose
# integrado, use a rede interna (por exemplo mongodb://mongo:27017/?replicaSet=rs0).
MAIN_API_MONGO_URI=mongodb://localhost:27027/?replicaSet=rs0&directConnection=true
MAIN_API_MONGO_DATABASE=argos_ai
MAIN_API_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MAIN_API_MONGO_WRITE_TIMEOUT_MS=5000

# Collections da API principal. Devem ser distintas entre si e dos registros de
# observabilidade configurados abaixo.
MAIN_API_MONGO_COLLECTION_SESSIONS=ai_sessions
MAIN_API_MONGO_COLLECTION_INTERACTIONS=ai_interactions
MAIN_API_MONGO_COLLECTION_MESSAGES=ai_messages
MAIN_API_MONGO_COLLECTION_EXECUTION_EVENTS=ai_execution_events
MAIN_API_MONGO_COLLECTION_SESSION_SUMMARIES=ai_session_summaries
MAIN_API_MONGO_COLLECTION_USER_MEMORY=ai_user_memory
MAIN_API_MONGO_COLLECTION_REPORT_ARTIFACTS=ai_report_artifacts
MAIN_API_MONGO_COLLECTION_EMAIL_PREPARATIONS=ai_email_preparations
MAIN_API_MONGO_COLLECTION_PENDING_RECIPIENT_RESOLUTIONS=ai_pending_recipient_resolutions
MAIN_API_MONGO_COLLECTION_EMAIL_SEND_AUTHORIZATIONS=ai_email_send_authorizations
MAIN_API_MONGO_COLLECTION_EMAIL_OPERATION_REFERENCES=ai_email_operation_references
MAIN_API_MONGO_COLLECTION_LANGGRAPH_CHECKPOINTS=ai_langgraph_checkpoints
MAIN_API_MONGO_COLLECTION_LANGGRAPH_CHECKPOINT_WRITES=ai_langgraph_checkpoint_writes

# Para habilitar a coleta local sem LangSmith, use esta collection no mesmo Mongo.
# Remova/omita a variável para desabilitar; não há expiração automática.
MAIN_API_OBSERVABILITY_COLLECTION=ai_observations
# MAIN_API_OBSERVABILITY_QUEUE_MAX_ITEMS=2048
# MAIN_API_OBSERVABILITY_QUEUE_MAX_BYTES=8388608
# MAIN_API_OBSERVABILITY_DOCUMENT_MAX_BYTES=16384
# MAIN_API_OBSERVABILITY_BATCH_SIZE=100
# MAIN_API_OBSERVABILITY_BATCH_INTERVAL_MS=250
# MAIN_API_OBSERVABILITY_MAX_ATTEMPTS=3
# MAIN_API_OBSERVABILITY_RETRY_BASE_DELAY_MS=50
# MAIN_API_OBSERVABILITY_SHUTDOWN_TIMEOUT_MS=2000

MAIN_API_SESSION_SUMMARY_INPUT_MAX_TOKENS=8000

# Um nome de modelo por agente. URL e chave do provider são compartilhadas.
# Os agentes podem usar o mesmo modelo ou modelos diferentes.
# A sumarização de sessão e a extração de memória reutilizam MAIN_API_MODEL_ROUTER.
# Sem configuração completa, /health/ready informa indisponibilidade do runtime.
# MAIN_API_MODEL_API_BASE_URL=https://openrouter.ai/api/v1
# MAIN_API_MODEL_API_KEY=
# MAIN_API_MODEL_ROUTER=openai/gpt-6-luna
# MAIN_API_MODEL_FARM=openai/gpt-6.1-sol
# MAIN_API_MODEL_DOCTOR=openai/gpt-6.1-sol
# MAIN_API_MODEL_ANALYST=openai/gpt-6.1-sol
# MAIN_API_MODEL_SECRETARY=openai/gpt-6.1-sol
# MAIN_API_MODEL_INFORMATION=openai/gpt-6.1-sol
# MAIN_API_MODEL_ORCHESTRATOR=openai/gpt-6-luna
# MAIN_API_MODEL_JUDGE=openai/gpt-6-luna
# MAIN_API_MODEL_QUESTION_FORMATTER=openai/gpt-6-luna
MAIN_API_MODEL_MODE=provider
MAIN_API_MODEL_TIMEOUT_SECONDS=60
MAIN_API_MODEL_MAX_RETRIES=2
MAIN_API_MODEL_MAX_OUTPUT_TOKENS=4096
MAIN_API_EXECUTION_MAX_MODEL_CALLS=12
MAIN_API_EXECUTION_MAX_TOOL_CALLS=12
MAIN_API_EXECUTION_TIMEOUT_SECONDS=180

# LangSmith é opcional. Sem API key, nenhum trace é enviado.
# A chave é um secret. Prompts e respostas ficam ocultos até habilitar explicitamente.
# MAIN_API_LANGSMITH_API_KEY=
# MAIN_API_LANGSMITH_PROJECT=argos-ai-service
# MAIN_API_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# MAIN_API_LANGSMITH_WORKSPACE_ID=workspace-id-for-organization-scoped-key
# MAIN_API_LANGSMITH_CAPTURE_CONTENT=false

# Chaves públicas Ed25519 em Base64 raw (32 bytes), indexadas pelo kid do backend.
# Nunca configure a chave privada aqui.
MAIN_API_AUTH_ISSUER=argos-backend-service
MAIN_API_AUTH_AUDIENCE=argos-ai-service
MAIN_API_AUTH_TRUSTED_PUBLIC_KEYS={"BACKEND_KEY_ID":"BASE64_RAW_ED25519_PUBLIC_KEY"}
MAIN_API_AUTH_TOKEN_MAX_TTL_SECONDS=300
MAIN_API_AUTH_CLOCK_SKEW_SECONDS=30

# Endpoints Streamable HTTP dos MCPs. Cada URL aponta para o endpoint /mcp.
MAIN_API_MCP_DATA_URL=https://MCP_DATA_HOST/mcp
MAIN_API_MCP_DATA_TOKEN=
# Chaves públicas Ed25519 em Base64 confiadas para envelopes LotReportEnvelope.
MAIN_API_MCP_DATA_REPORT_TRUSTED_SIGNATURE_KEYS={"REPORT_SIGNING_KEY_ID":"BASE64_RAW_ED25519_PUBLIC_KEY"}
MAIN_API_MCP_PREDICTION_URL=https://MCP_PREDICTION_HOST/mcp
MAIN_API_MCP_PREDICTION_TOKEN=
MAIN_API_MCP_EMAIL_URL=https://MCP_EMAIL_HOST/mcp
MAIN_API_MCP_EMAIL_TOKEN=
MAIN_API_MCP_TIMEOUT_SECONDS=10
MAIN_API_MCP_RESPONSE_MAX_BYTES=1000000

# Chave PKCS#8 DER Ed25519, codificada em Base64, para assinar delegações por chamada.
# Configure a chave pública correspondente e o mesmo issuer nos MCPs Data e Prediction.
MAIN_API_MCP_DELEGATION_ISSUER=argos-main-service
MAIN_API_MCP_DELEGATION_KEY_ID=MAIN_API_DELEGATION_KEY_ID
MAIN_API_MCP_DELEGATION_PRIVATE_KEY=BASE64_PKCS8_DER_ED25519_PRIVATE_KEY
MAIN_API_MCP_DELEGATION_TTL_SECONDS=240

# Cliente opcional do serviço documental A2A. O issuer deve coincidir com
# A2A_DELEGATION_ISSUER no serviço A2A; a URL é também a audience assinada.
# MAIN_API_DOCUMENT_A2A_URL=https://a2a.internal.example/a2a
# MAIN_API_DOCUMENT_A2A_SERVICE_TOKEN=replace-with-a2a-service-token
# MAIN_API_DOCUMENT_A2A_TIMEOUT_SECONDS=45
# MAIN_API_DOCUMENT_A2A_RESPONSE_MAX_BYTES=1000000
# Contadores efêmeros de chamadas e tokens por usuário (opcional localmente).
MAIN_API_OBSERVABILITY_REDIS_URL=redis://localhost:6379/0
USER_USAGE_REDIS_KEY_PREFIX=argos:usage:users:v1

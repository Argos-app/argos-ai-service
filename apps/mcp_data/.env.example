# Template only. Supply real values through the process/container secret store.
# Do not commit a filled .env file or private signing keys.

# PostgreSQL DSN for a database account with SELECT access only.
MCP_DATA_SQL_DSN=postgresql://READ_ONLY_USER:URL_ENCODED_PASSWORD@POSTGRES_HOST:5432/DATABASE

# MongoDB connection and actual collection names from the target environment.
MCP_DATA_MONGO_URI=mongodb://READ_ONLY_USER:URL_ENCODED_PASSWORD@MONGO_HOST:27017/
# Os dois MCPs que persistem dados próprios compartilham o banco argos_ai.
MCP_DATA_MONGO_DATABASE=argos_ai
MCP_DATA_MONGO_CATTLE_COLLECTION=CATTLE_COLLECTION
MCP_DATA_MONGO_RELATIONAL_ID_FORMAT=REPLACE_WITH_string_OR_uuid_standard
MCP_DATA_MONGO_MEDICINE_COLLECTION=MEDICINE_COLLECTION
MCP_DATA_MONGO_MEDICINE_ID_FORMAT=REPLACE_WITH_string_OR_uuid_standard

# Internal MCP bearer token. Configure the same value at the calling client.
MCP_DATA_INTERNAL_SERVICE_TOKEN=REPLACE_WITH_SECRET
MCP_DATA_AUTH_ISSUER_URL=https://AUTH_ISSUER
MCP_DATA_RESOURCE_SERVER_URL=https://MCP_HOST/mcp

# Must match the issuer and key ID used by the service that signs delegations.
# Each value must be a Base64 Ed25519 public key (32 decoded bytes).
MCP_DATA_DELEGATION_ISSUER=DELEGATION_ISSUER
MCP_DATA_TRUSTED_DELEGATION_KEYS={"KEY_ID":"BASE64_ED25519_PUBLIC_KEY"}
MCP_DATA_DELEGATION_MAX_TTL=300
MCP_DATA_DELEGATION_CLOCK_SKEW=30

# Bind inside the service/container; publish the port through the environment's
# network or reverse proxy as https://MCP_HOST/mcp.
MCP_DATA_HOST=0.0.0.0
MCP_DATA_PORT=8000

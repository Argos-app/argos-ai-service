# Apenas um modelo. Informe os valores reais pelo armazenamento de segredos do processo ou contêiner.
# Não envie ao repositório um arquivo .env preenchido nem chaves privadas.

# DSN do PostgreSQL para uma conta de banco com acesso somente a SELECT.
MCP_DATA_SQL_DSN=postgresql://READ_ONLY_USER:URL_ENCODED_PASSWORD@POSTGRES_HOST:5432/DATABASE

# Conexão MongoDB. O serviço lê estas collections fixas:
# cattle_documents e medicine_documents.
MCP_DATA_MONGO_URI=mongodb://READ_ONLY_USER:URL_ENCODED_PASSWORD@MONGO_HOST:27017/
# Os dois MCPs que persistem dados próprios compartilham o banco argos_ai.
MCP_DATA_MONGO_DATABASE=argos_ai
MCP_DATA_MONGO_RELATIONAL_ID_FORMAT=REPLACE_WITH_string_OR_uuid_standard
MCP_DATA_MONGO_MEDICINE_ID_FORMAT=REPLACE_WITH_string_OR_uuid_standard

# Token Bearer interno do MCP. Configure o mesmo valor no cliente chamador.
MCP_DATA_INTERNAL_SERVICE_TOKEN=REPLACE_WITH_SECRET
MCP_DATA_AUTH_ISSUER_URL=https://AUTH_ISSUER
MCP_DATA_RESOURCE_SERVER_URL=https://MCP_HOST/mcp

# Deve corresponder ao emissor e ao ID da chave usados pelo serviço que assina as delegações.
# Cada valor deve ser uma chave pública Ed25519 em Base64 (32 bytes após a decodificação).
MCP_DATA_DELEGATION_ISSUER=DELEGATION_ISSUER
MCP_DATA_TRUSTED_DELEGATION_KEYS={"KEY_ID":"BASE64_ED25519_PUBLIC_KEY"}
MCP_DATA_DELEGATION_MAX_TTL=300
MCP_DATA_DELEGATION_CLOCK_SKEW=30

# Chave PKCS#8 DER Ed25519, codificada em Base64. A pública correspondente
# deve constar em MCP_EMAIL_TRUSTED_SIGNATURE_KEYS no consumidor.
MCP_DATA_REPORT_SIGNING_KEY_ID=REPORT_SIGNING_KEY_ID
MCP_DATA_REPORT_SIGNING_PRIVATE_KEY=BASE64_PKCS8_DER_ED25519_PRIVATE_KEY
MCP_DATA_REPORT_ENVELOPE_TTL_SECONDS=300

MCP_DATA_HOST=0.0.0.0
MCP_DATA_PORT=8000
